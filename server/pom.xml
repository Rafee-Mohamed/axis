<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.disys</groupId>
        <artifactId>axis</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>server</artifactId>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.disys.axis.server.Main</mainClass>
                                </transformer>
                                <!-- merges META-INF/services — required for gRPC provider loading -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- Client-facing gRPC service definitions -->
        <dependency>
            <groupId>io.disys</groupId>
            <artifactId>api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Raft consensus + WAL-backed log -->
        <dependency>
            <groupId>io.disys</groupId>
            <artifactId>consensus</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- MVCC state machine - direct dep, server reads and drives compaction -->
        <dependency>
            <groupId>io.disys</groupId>
            <artifactId>mvcc</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Lease store - direct dep, apply loop drives grant/revoke/checkpoint -->
        <dependency>
            <groupId>io.disys</groupId>
            <artifactId>lease</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- LMDB backend - needed for AxisServer startup wiring -->
        <dependency>
            <groupId>io.disys</groupId>
            <artifactId>backend-lmdb</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- YAML config file parsing -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.3</version>
        </dependency>

        <!-- gRPC Netty transport - needed to bind the server port -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
        </dependency>
    </dependencies>

</project>
